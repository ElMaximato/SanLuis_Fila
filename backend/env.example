# Puerto donde escucha el backend
PORT=8787

# Origen(es) del frontend autorizados por CORS, separados por coma
# (en desarrollo con el proxy de Vite no hace falta, pero no estorba)
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173

# Cruce a mostrar: 260801 = San Luis I
CROSSING_ID=260801

# Cuánto tiempo se reutiliza el dato antes de volver a pedirlo a CBP
CACHE_TTL_SECONDS=300

# Si CBP falla, se sirve el último dato guardado hasta este límite
STALE_MAX_SECONDS=3600

# Peticiones por minuto y por IP
RATE_LIMIT_PER_MIN=60

# Pon 1 solo si el backend corre detrás de un proxy (Render, Fly, Nginx...)
TRUST_PROXY=1
